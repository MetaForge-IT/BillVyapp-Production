NODE_ENV=development
PORT=3000
APP_NAME=Salon Management API
LOG_LEVEL=debug
API_PREFIX=/api

# Database (docker-compose uses mysql service; override for remote host)
DATABASE_URL="mysql://salon_app:salon_dev_pass@mysql:3306/saloon_app"

# Auth (required)
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend / CORS
CORS_ORIGIN=http://localhost
FRONTEND_URL=http://localhost
API_PUBLIC_URL=http://localhost/api

# Redis cache
REDIS_URL=redis://redis:6379
REDIS_DASHBOARD_TTL_SECONDS=60

# File storage: local | s3
FILES_STORAGE=local
LOCAL_UPLOAD_DIR=uploads

# AWS S3 (production)
# FILES_STORAGE=s3
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=your-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_PUBLIC_BASE_URL=https://your-cdn.example.com

# Observability (optional)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
