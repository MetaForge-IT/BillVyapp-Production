NODE_ENV=development
PORT=3000
APP_NAME=Salon Management API
LOG_LEVEL=debug
API_PREFIX=/api
# Remote MySQL — replace host, user, password (URL-encode special chars), and database name
DATABASE_URL="mysql://salon_app:YOUR_URL_ENCODED_PASSWORD@192.168.1.238:3306/new_salon_app"
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Auth (required)
JWT_ACCESS_SECRET=change-me-dev-secret-min-32-chars-long

# Billing — manager PIN for refund approval (default: 1234)
REFUND_APPROVAL_PIN=1234

# Redis (optional — dashboard cache + auth context cache)
# REDIS_URL=redis://localhost:6379
# REDIS_AUTH_USER_TTL_SECONDS=120

# Files: local | s3
FILES_STORAGE=local
LOCAL_UPLOAD_DIR=uploads

# AWS S3 (production)
# FILES_STORAGE=s3
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_PUBLIC_BASE_URL=

# Sentry (optional)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# SMTP (required in production for signup, password reset, and login OTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=noreply@your-domain.com
# SMTP_FROM_NAME=BillVyapp

# Login OTP (two-step verification)
# LOGIN_OTP_EXPIRES_IN=10m
# Dev/test only — never enable in production. Returns OTP in login API response for Playwright.
LOGIN_OTP_RETURN_IN_RESPONSE=true

# Prometheus metrics (/api/metrics) — required in production; use Bearer or X-Metrics-Token header
# METRICS_TOKEN=change-me-metrics-secret
