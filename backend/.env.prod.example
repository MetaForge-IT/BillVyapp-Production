NODE_ENV=production
PORT=3000
APP_NAME=BillVyapp API
LOG_LEVEL=info
API_PREFIX=/api

# ── Database (required) — RDS / external MySQL ───────────────────────────────
DATABASE_URL="mysql://USER:URL_ENCODED_PASSWORD@your-rds-endpoint:3306/new_salon_app"

# ── Auth (required) — use a long random secret (32+ chars) ───────────────────
JWT_ACCESS_SECRET=replace-with-strong-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Public URLs / CORS (required) — must match HTTPS domain ──────────────────
CORS_ORIGIN=https://billvyapp.com,https://www.billvyapp.com,https://app.billvyapp.com
FRONTEND_URL=https://billvyapp.com
API_PUBLIC_URL=https://api.billvyapp.com

# ── Billing ──────────────────────────────────────────────────────────────────
REFUND_APPROVAL_PIN=1234

# ── Redis (compose service name on EC2; also powers BullMQ WhatsApp queue) ───
REDIS_URL=redis://redis:6379
REDIS_DASHBOARD_TTL_SECONDS=60

# ── SMTP (required for signup verification + password reset) ─────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=BillVyapp

# ── Files: local | s3 ────────────────────────────────────────────────────────
FILES_STORAGE=s3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=

# Local fallback (if FILES_STORAGE=local)
LOCAL_UPLOAD_DIR=uploads

# ── WhatsApp Sparklebot (login OTP + templates via BullMQ) ───────────────────
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=sparklebot
WHATSAPP_TENANT_SUBDOMAIN=thestarrkuts
WHATSAPP_API_BASE_URL=https://sparklebot.in/api/v1
WHATSAPP_ACCESS_TOKEN=replace-with-sparklebot-api-token
WHATSAPP_OTP_TEMPLATE_NAME=starrkuts_login_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_IN
WHATSAPP_OTP_BODY_FIELD_COUNT=1
WHATSAPP_TEMPLATE_LANGUAGE=en_IN
VERIFICATION_CHANNELS=whatsapp
SMS_ENABLED=false
LOGIN_OTP_RETURN_IN_RESPONSE=false

# ── Observability (optional) ─────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
