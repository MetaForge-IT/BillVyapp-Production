{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/api/**/*.ts",
    "src/lib/**/*.ts",
    "src/hooks/**/*.ts",
    "src/services/**/*.ts",
    "src/types/**/*.ts",
    "src/app/context/**/*.tsx"
  ]
}
