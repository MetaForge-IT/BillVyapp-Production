# Root env for docker-compose.prod.yml (copy to .env.prod on EC2 — never commit)
#
#   cp .env.prod.example .env.prod
#   cp backend/.env.prod.example backend/.env.prod
#   edit both files, then: ./scripts/deploy-ec2.sh
#
# GitHub Actions CD secrets (repo Settings → Secrets):
#   EC2_HOST, EC2_USER, EC2_SSH_KEY, EC2_DEPLOY_PATH
#   EC2_SSH_PORT (optional, default 22)
#   GHCR_TOKEN (PAT with read:packages), GHCR_USER (optional)

# Public hostname (used by deploy scripts / image tags)
DOMAIN=billvyapp.com

# Images pushed by GitHub Actions CD (GHCR)
# Format: ghcr.io/<github-org-or-user>/salon-api:latest
API_IMAGE=ghcr.io/OWNER/salon-api:latest
FRONTEND_IMAGE=ghcr.io/OWNER/salon-frontend:latest

# Frontend build-time (optional)
VITE_SENTRY_DSN=

# Grafana (change immediately)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
